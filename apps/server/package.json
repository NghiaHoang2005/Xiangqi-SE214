{
  "name": "@xiangqi/server",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS + Socket.IO backend — the authoritative source of game state (SRS 3.3)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/platform-socket.io": "10.4.15",
    "@nestjs/websockets": "10.4.15",
    "@xiangqi/rules": "workspace:*",
    "@xiangqi/shared": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@swc/core": "1.10.1",
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "socket.io-client": "4.8.1",
    "typescript": "5.7.2",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
